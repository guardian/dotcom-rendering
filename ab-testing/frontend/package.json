{
	"name": "@guardian/ab-testing-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf ./output && vite build && mv ./output/index.html ./output/ab-tests.html",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@guardian/ab-testing-config": "workspace:ab-testing-config",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "catalog:",
		"vite": "8.3.5"
	}
}
